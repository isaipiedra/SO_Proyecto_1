<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0.3 -->
<interface>
  <!-- interface-name builder.ui -->
  <requires lib="gtk" version="4.0"/>
  <object class="GtkWindow" id="window">
    <property name="default-height">250</property>
    <property name="default-width">440</property>
    <property name="title">I &lt;3 Huffman</property>
    <child>
      <object class="GtkBox" id="layout_holder">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkBox" id="box_header">
            <property name="valign">center</property>
            <child>
              <object class="GtkBox">
                <property name="homogeneous">True</property>
                <property name="width-request">100</property>
                <child>
                  <object class="GtkButton" id="btn_back">
                    <property name="halign">center</property>
                    <property name="height-request">32</property>
                    <property name="valign">center</property>
                    <property name="visible">False</property>
                    <property name="width-request">32</property>
                    <child>
                      <object class="GtkImage">
                        <property name="height-request">32</property>
                        <property name="visible">False</property>
                        <property name="width-request">32</property>
                      </object>
                    </child>
                    <style>
                      <class name="btn_back"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="lbl_title">
                <property name="halign">center</property>
                <property name="hexpand">True</property>
                <property name="label">Compress</property>
                <property name="valign">center</property>
                <property name="visible">False</property>
                <style>
                  <class name="lbl_title"/>
                </style>
              </object>
            </child>
            <style>
              <class name="box_header"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkScrolledWindow">
            <child>
              <object class="GtkBox" id="layout_compress_mode">
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkBox">
                    <property name="hexpand">True</property>
                    <property name="vexpand">True</property>
                    <child>
                      <object class="GtkBox" id="box_dnd_container">
                        <property name="hexpand">True</property>
                        <property name="name">box_container01</property>
                        <property name="orientation">vertical</property>
                        <property name="vexpand">True</property>
                        <child>
                          <object class="GtkBox" id="dnd_content">
                            <property name="halign">center</property>
                            <property name="orientation">vertical</property>
                            <property name="valign">center</property>
                            <property name="vexpand">True</property>
                            <child>
                              <object class="GtkImage">
                                <property name="file">images/download.png</property>
                                <property name="height-request">128</property>
                                <property name="margin-bottom">10</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="lbl_initial_msg">
                                <property name="label" translatable="yes">Drag and drop your directory</property>
                                <property name="name">lbl_initial_msg</property>
                                <style>
                                  <class name="lbl_initial_msg"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="valign">center</property>
                                <child>
                                  <object class="GtkSeparator" id="separator_2">
                                    <property name="hexpand">True</property>
                                    <property name="opacity">0.5</property>
                                    <property name="valign">center</property>
                                    <style>
                                      <class name="separator"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="lbl_or">
                                    <property name="label" translatable="yes">OR</property>
                                    <property name="name">lbl_or</property>
                                    <style>
                                      <class name="lbl_or"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkSeparator" id="separator_1">
                                    <property name="hexpand">True</property>
                                    <property name="opacity">0.5</property>
                                    <property name="valign">center</property>
                                    <style>
                                      <class name="separator"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="btn_open_file_explorer">
                                <property name="label" translatable="yes">Browse for Directory</property>
                                <property name="name">btn_open_file_explorer</property>
                                <style>
                                  <class name="btn_open_file_explorer"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                        <style>
                          <class name="box_dnd_container"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="box_file_explorer_container">
                        <property name="orientation">vertical</property>
                        <child>
                          <object class="GtkScrolledWindow" id="scroll_file_explorer">
                            <property name="min-content-width">300</property>
                            <property name="vexpand">True</property>
                            <child>
                              <object class="GtkBox" id="box_file_explorer">
                                <property name="hexpand">True</property>
                                <property name="orientation">vertical</property>
                                <style>
                                  <class name="box_file_explorer"/>
                                </style>
                              </object>
                            </child>
                            <style>
                              <class name="scroll_file_explorer"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox" id="box_output_name">
                            <property name="valign">end</property>
                            <child>
                              <object class="GtkButton" id="btn_output_browse_dir">
                                <child>
                                  <object class="GtkImage">
                                    <property name="file">images/folder.png</property>
                                  </object>
                                </child>
                                <style>
                                  <class name="btn_output_browse_dir"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="entry_output_name">
                                <property name="hexpand">True</property>
                                <property name="placeholder-text">output</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">.jix</property>
                              </object>
                            </child>
                            <style>
                              <class name="box_output_name"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="btn_compile">
                            <property name="halign">end</property>
                            <child>
                              <object class="GtkBox" id="box_compile">
                                <property name="spacing">10</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label">Compress</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkImage">
                                    <property name="file">images/right-arrow.png</property>
                                  </object>
                                </child>
                                <style>
                                  <class name="box_compile"/>
                                </style>
                              </object>
                            </child>
                            <style>
                              <class name="btn_compile"/>
                            </style>
                          </object>
                        </child>
                        <style>
                          <class name="box_file_explorer_container"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkScrolledWindow">
            <property name="visible">False</property>
            <child>
              <object class="GtkBox" id="layout_decompress_mode">
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkBox">
                    <property name="hexpand">True</property>
                    <property name="orientation">vertical</property>
                    <property name="vexpand">True</property>
                    <child>
                      <object class="GtkBox" id="bottom_section_decomp">
                        <property name="orientation">vertical</property>
                        <child>
                          <object class="GtkBox" id="box_selected_file">
                            <property name="halign">center</property>
                            <child>
                              <object class="GtkBox" id="comp_selected_file">
                                <property name="halign">center</property>
                                <property name="orientation">vertical</property>
                                <property name="valign">center</property>
                                <property name="vexpand">True</property>
                                <child>
                                  <object class="GtkImage">
                                    <property name="file">images/box_big.png</property>
                                    <property name="height-request">128</property>
                                    <property name="hexpand">True</property>
                                    <property name="vexpand">True</property>
                                    <property name="width-request">128</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="lbl_selected_decomp_file">
                                    <property name="label">Name of the File.jix</property>
                                    <style>
                                      <class name="lbl_selected_decomp_file"/>
                                    </style>
                                  </object>
                                </child>
                                <style>
                                  <class name="comp_selected_file"/>
                                </style>
                              </object>
                            </child>
                            <style>
                              <class name="box_selected_file"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox" id="box_export_section">
                            <property name="orientation">vertical</property>
                            <child>
                              <object class="GtkBox" id="box_output_name_decomp">
                                <property name="valign">end</property>
                                <child>
                                  <object class="GtkButton" id="btn_output_browse_dir_decomp">
                                    <child>
                                      <object class="GtkImage">
                                        <property name="file">images/folder.png</property>
                                      </object>
                                    </child>
                                    <style>
                                      <class name="btn_output_browse_dir"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkEntry" id="entry_output_name_decomp">
                                    <property name="hexpand">True</property>
                                    <property name="placeholder-text">output</property>
                                  </object>
                                </child>
                                <style>
                                  <class name="box_output_name"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="btn_decompress">
                                <property name="halign">end</property>
                                <child>
                                  <object class="GtkBox" id="box_compile_decompress">
                                    <property name="spacing">10</property>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label">Decompress</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkImage">
                                        <property name="file">images/right-arrow.png</property>
                                      </object>
                                    </child>
                                    <style>
                                      <class name="box_compile"/>
                                    </style>
                                  </object>
                                </child>
                                <style>
                                  <class name="btn_compile"/>
                                </style>
                              </object>
                            </child>
                            <style>
                              <class name="box_export_section"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkScrolledWindow">
            <property name="visible">False</property>
            <child>
              <object class="GtkBox" id="layout_stats_mode">
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkBox" id="box_stats_container">
                    <property name="halign">center</property>
                    <property name="orientation">vertical</property>
                    <property name="valign">center</property>
                    <property name="vexpand">True</property>
                    <child>
                      <object class="GtkLabel" id="lbl_stats_title">
                        <property name="halign">center</property>
                        <property name="label" translatable="yes">Statistics </property>
                        <property name="margin-bottom">20</property>
                        <style>
                          <class name="lbl_stats_title"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkGrid" id="grid_stats_table">
                        <property name="column-spacing">50</property>
                        <property name="row-spacing">14</property>
                        <child>
                          <object class="GtkLabel" id="lbl_stats_col_metric">
                            <property name="halign">start</property>
                            <property name="label" translatable="yes">Metric</property>
                            <style>
                              <class name="lbl_stats_header"/>
                            </style>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="lbl_stats_col_serial">
                            <property name="halign">center</property>
                            <property name="label" translatable="yes">Serial</property>
                            <style>
                              <class name="lbl_stats_header"/>
                            </style>
                            <layout>
                              <property name="column">1</property>
                              <property name="row">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="lbl_stats_col_concurrent">
                            <property name="halign">center</property>
                            <property name="label" translatable="yes">Concurrent</property>
                            <style>
                              <class name="lbl_stats_header"/>
                            </style>
                            <layout>
                              <property name="column">2</property>
                              <property name="row">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="lbl_stats_col_parallel">
                            <property name="halign">center</property>
                            <property name="label" translatable="yes">Parallel</property>
                            <style>
                              <class name="lbl_stats_header"/>
                            </style>
                            <layout>
                              <property name="column">3</property>
                              <property name="row">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="lbl_stats_row_health">
                            <property name="halign">start</property>
                            <property name="label" translatable="yes">Compression health (%)</property>
                            <style>
                              <class name="lbl_stats_row"/>
                            </style>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">1</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="lbl_stat_health_serial">
                            <property name="halign">center</property>
